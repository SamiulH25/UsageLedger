<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:contentDescription="@string/widget_content_description"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wl_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.12"
            android:text="NEXT WALL"
            android:textColor="#C4A35A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wl_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textColor="#F2EDE4"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/wl_used"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Add an account to start tracking"
        android:textColor="#A39888"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/wl_pool_1"
        style="@style/UsageLedgerPoolRow"
        android:layout_marginTop="10dp"
        android:text="" />

    <TextView
        android:id="@+id/wl_pool_2"
        style="@style/UsageLedgerPoolRow"
        android:text="" />

    <TextView
        android:id="@+id/wl_pool_3"
        style="@style/UsageLedgerPoolRow"
        android:text="" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wl_reset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#A39888"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/wl_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#A39888"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
